{
  "name": "syntax-sensei",
  "displayName": "Syntax-Sensei",
  "description": "Offline AI coding mentor and programming academy for VS Code — Phase 2",
  "version": "0.2.1",
  "publisher": "nobelesse",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension/extension.js",
  "activationEvents": [
    "onView:syntaxSensei.sidebar",
    "onCommand:syntaxSensei.openDashboard",
    "onCommand:syntaxSensei.checkConnection",
    "onCommand:syntaxSensei.explainSelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "syntaxSensei.openDashboard",
        "title": "Syntax-Sensei: Open Learning Dashboard",
        "category": "Syntax-Sensei"
      },
      {
        "command": "syntaxSensei.checkConnection",
        "title": "Syntax-Sensei: Check Backend Connection",
        "category": "Syntax-Sensei"
      },
      {
        "command": "syntaxSensei.explainSelection",
        "title": "Syntax-Sensei: Explain Selected Code",
        "category": "Syntax-Sensei"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syntaxSensei",
          "title": "Syntax-Sensei",
          "icon": "media/sensei.svg"
        }
      ]
    },
    "views": {
      "syntaxSensei": [
        {
          "type": "webview",
          "id": "syntaxSensei.sidebar",
          "name": "Learning Workspace"
        }
      ]
    },
    "configuration": {
      "title": "Syntax-Sensei",
      "properties": {
        "syntaxSensei.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Python interpreter containing FastAPI and Uvicorn. Leave empty to use the project .venv."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "syntaxSensei.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:extension": "tsc -p tsconfig.extension.json",
    "check:webview": "tsc -p tsconfig.webview.json",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run check:webview && npm run build:webview",
    "test:webview": "vitest run",
    "test": "npm run check:webview && npm run test:webview",
    "watch:extension": "tsc -p tsconfig.extension.json -w",
    "package:vsix": "npm run build && vsce package"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/vscode": "1.96.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vscode/vsce": "4.1.1",
    "typescript": "5.7.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.8"
    }
  }
}
